{{!
    ROFEO "Why choose us" section, included from theme_moove/frontpage between
    the catalogue and the FAQ. Self-contained: gated by {{#whyenabled}} here,
    so the include is a no-op when the section is disabled.

    Context variables required for this template:
    * whyenabled, whytitle, whysubtitle, whycards - theme_rofeo settings,
      supplied by layout/frontpage.php. Each whycards entry has icon, title, body.
}}
{{#whyenabled}}
    <section class="rofeo-why">
        <div class="rofeo-why__inner">
            <h2 class="rofeo-why__heading">{{{ whytitle }}}</h2>
            {{#whysubtitle}}
                <div class="rofeo-why__subtitle">{{{ whysubtitle }}}</div>
            {{/whysubtitle}}

            <div class="rofeo-why__grid">
                {{#whycards}}
                    <div class="rofeo-why__card">
                        <div class="rofeo-why__icon"><i class="fa {{ icon }}"></i></div>
                        <h3 class="rofeo-why__card-title">{{{ title }}}</h3>
                        <p class="rofeo-why__card-body">{{{ body }}}</p>
                    </div>
                {{/whycards}}
            </div>
        </div>
    </section>
{{/whyenabled}}
