{{!
    @template core/email_html
    ROFEO branded wrapper for all HTML emails.
    Context variables required for this template:
    * sitefullname
    * sitewwwroot
    * subject
    * body
}}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{subject}}</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f5f7; font-family:Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f5f7;">
  <tr>
    <td align="center" style="padding:24px 12px;">

      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
             style="width:600px; max-width:100%; background-color:#ffffff; border-radius:6px;">

        <tr>
          <td style="background-color:#0f47ad; padding:20px 28px;">
            <a href="{{{sitewwwroot}}}"
               style="color:#ffffff; font-size:20px; font-weight:bold; text-decoration:none;">{{sitefullname}}</a>
          </td>
        </tr>

        <tr>
          <td style="padding:28px; color:#25282b; font-size:15px; line-height:1.6;">
            {{{body}}}
          </td>
        </tr>

        <tr>
          <td style="padding:18px 28px; background-color:#f0f1f3; color:#6b7075; font-size:12px; line-height:1.5;">
            <p style="margin:0 0 6px 0;">
              Cet email vous a été envoyé par
              <a href="{{{sitewwwroot}}}" style="color:#0f47ad;">{{sitefullname}}</a>.
            </p>
            <p style="margin:0;">Si vous n'êtes pas à l'origine de cette demande, ignorez ce message.</p>
          </td>
        </tr>

      </table>

    </td>
  </tr>
</table>
</body>
</html>