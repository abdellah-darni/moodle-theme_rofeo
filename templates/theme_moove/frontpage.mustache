{{!
    @template theme_moove/frontpage

    ROFEO override of moove's anonymous front page.
    Forked from theme_moove (branch main, August 2026). Re-check against
    upstream after any moove update.

    Differences from upstream:
      - slider, marketing boxes and numbers sections removed
      - hero section added, driven by theme_rofeo settings
      - #catalogue anchor added ahead of the course list
      - "why choose us" section added between the course list and the FAQ
      - FAQ moved from moove's own settings page to theme_rofeo settings, so
        every front page setting lives on one admin page; moove's
        theme_moove\util\settings::frontpage() is no longer used here at all
        (its footer() call is separate and still is)
      - carousel JS removed (no slider markup left to initialise)
      - #topofscroll renamed to #rofeo-topofscroll: moove scopes ~190 lines
        of styling (scss/moove/_frontpage.scss) to #page-site-index.notloggedin,
        including #topofscroll and its #page-content/#region-main children.
        Since this fork removed moove's !isloggedin() gate, that block would
        otherwise apply only when logged out. Not referenced by any core or
        moove JS - safe to rename. #faq was renamed to #rofeo-faq for the
        same reason in an earlier pass. #page (the outer drawers wrapper) has
        the same collision but is NOT renamed: theme_boost/amd/src/drawers.js
        and sticky-footer.js depend on that literal id, and moove's rule uses
        !important, so no selector-only fix is possible - see docs/PROGRESS.md.

    Context variables required for this template:
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * herotitle / herosubtitle / heroctalabel / heroctaurl - supplied by
      theme_rofeo's layout/frontpage.php from theme_rofeo settings
    * whyenabled / whytitle / whysubtitle / whycards - "why choose us" section,
      rendered by the self-contained theme_rofeo/why partial (gated internally
      on whyenabled), supplied by theme_rofeo's layout/frontpage.php
    * faqenabled / faqtitle / faqsubtitle / faqitems - FAQ section, rendered
      by the self-contained theme_rofeo/faq partial (gated internally on
      faqenabled), supplied by theme_rofeo's layout/frontpage.php
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_moove/navbar }}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers drag-container bg-white">

        <section class="rofeo-hero">
            <img src="{{ heroimageurl }}" alt="" aria-hidden="true"
                 class="rofeo-hero__bg" fetchpriority="high">
            <div class="rofeo-hero__scrim"></div>
            <div class="rofeo-hero__inner">
                <div class="rofeo-hero__content">
                    <h1 class="rofeo-hero__title">{{ herotitle }}</h1>
                    <div class="rofeo-hero__subtitle">{{{ herosubtitle }}}</div>
                    {{#heroctalabel}}
                        <a href="{{ heroctaurl }}" class="btn btn-lg rofeo-hero__cta">
                            {{ heroctalabel }}
                        </a>
                    {{/heroctalabel}}
                </div>
            </div>
        </section>

        {{> theme_rofeo/catalogue }}

        <div id="rofeo-topofscroll">
            <div id="page-content" class="d-print-block main-inner">
                <div id="region-main-box">
                    <section id="region-main" aria-label="{{#str}}content{{/str}}">
                        <span id="catalogue" class="rofeo-anchor"></span>
                        {{{ output.course_content_header }}}
                        {{{ output.main_content }}}
                        {{{ output.course_content_footer }}}
                    </section>
                </div>
            </div>
        </div>

        {{> theme_rofeo/why }}

        {{> theme_rofeo/faq }}

    </div>

    {{> theme_moove/footer }}

    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
    M.util.js_pending('theme_boost/loader');
    require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
        Drawer.init();
        M.util.js_complete('theme_boost/loader');
    });
{{/js}}