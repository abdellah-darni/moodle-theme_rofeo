{{#hascategories}}
<section class="rofeo-catalogue" id="catalogue">
    <div class="rofeo-catalogue__inner">
        <h2 class="rofeo-catalogue__heading">{{{ cataloguetitle }}}</h2>

        {{#categories}}
            <div class="rofeo-catalogue__group">
                <h3 class="rofeo-catalogue__category">{{{ name }}}</h3>
                <div class="rofeo-grid">
                    {{#courses}}
                        <article class="rofeo-card">
                            <a href="{{ infourl }}" class="rofeo-card__body">
                                {{#hidden}}
                                    <span class="badge badge-warning rofeo-card__badge">{{#str}}coursehiddenbadge, theme_rofeo{{/str}}</span>
                                {{/hidden}}
                                {{#hasimage}}
                                    <img src="{{ image }}" alt="" class="rofeo-card__img" loading="lazy">
                                {{/hasimage}}
                                {{^hasimage}}
                                    <div class="rofeo-card__img rofeo-card__img--empty"></div>
                                {{/hasimage}}
                                <h4 class="rofeo-card__title">{{{ fullname }}}</h4>
                                {{#summary}}
                                    <p class="rofeo-card__summary">{{ summary }}</p>
                                {{/summary}}
                                <span class="btn btn-primary btn-sm rofeo-card__cta">{{{ coursectalabel }}}</span>
                            </a>
                        </article>
                    {{/courses}}
                </div>
            </div>
        {{/categories}}
    </div>
</section>
{{/hascategories}}